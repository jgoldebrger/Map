# Supabase — use your project values from the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Database — encode # in password as %23
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
SUPABASE_DB_DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Local dev only — do NOT set localhost on Vercel Production (causes login → localhost redirect).
# On Vercel Production:
#   AUTH_SECRET = (required, random string)
#   AUTH_TRUST_HOST = true   ← boolean flag, NOT a URL
#   Omit AUTH_URL / NEXTAUTH_URL (trustHost handles it), OR set both to https://your-app.vercel.app
#   Do NOT set AUTH_URL or NEXTAUTH_URL to "true" — that causes Invalid URL errors.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="pk.your_mapbox_token"

# Ship-date Q&A assistant (server-side only — never expose to the browser)
OPENAI_API_KEY="sk-your_openai_key"
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL="gpt-4o-mini"

ADMIN_EMAIL="admin@example.com"
# Required in production/CI — omit only for local dev (seed warns and uses changeme)
ADMIN_PASSWORD=""
# Partner iframe whitelist — comma-separated origins allowed to frame /embed/map
# EMBED_ALLOWED_ORIGINS="https://dealer.example.com,https://www.dealer.example.com"
